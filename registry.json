{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "foglamp",
  "homepage": "https://github.com/PakandAlive/fogui-style",
  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Foglamp Theme",
      "description": "Foglamp color tokens, shadow-instead-of-border stack, squircle radii, and motion keyframes, shipped as one self-contained CSS file.",
      "dependencies": [
        "tw-animate-css",
        "@toolwind/corner-shape"
      ],
      "docs": "Add `@import \"./foglamp-theme.css\";` (adjust the path to where the file landed) right after `@import \"tailwindcss\";` in your global CSS.",
      "files": [
        {
          "path": "registry/theme/foglamp-theme.css",
          "type": "registry:file",
          "target": "@lib/foglamp-theme.css"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
